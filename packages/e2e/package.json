{
  "name": "@bidar/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BidarCRM E2E and Synthetic Monitoring Suite based on @wpdev/monitor-core",
  "scripts": {
    "start": "node index.js",
    "start:local": "cross-env MONITOR_ENV=local node index.js",
    "start:staging": "cross-env MONITOR_ENV=staging node index.js",
    "start:prod": "cross-env MONITOR_ENV=prod node index.js",
    "test": "node --test test/core.test.js",
    "test:e2e": "node --test test/e2e-simulation.test.js",
    "test:all": "node --test test/*.test.js"
  },
  "dependencies": {
    "@wpdev/monitor-core": "github:abolfazl-moeini/wp-monitor#main",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
