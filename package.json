{
  "name": "@didar/didar-crm",
  "version": "0.1.0",
  "description": "Didar CRM — Open Source Modular WordPress CRM clone",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm-run-all --parallel build:dependencies build:components build:styles build:assets",
    "build:dependencies": "wpdev-build-dependencies",
    "build:components": "wpdev-build-components",
    "build:styles": "wpdev-build-styles",
    "build:assets": "wpdev-build-assets",
    "release": "node dev/release/run-release.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "wpdev-check"
  },
  "dependencies": {
    "@preact/compat": "^18.3.2",
    "@preact/signals": "^2.9.1",
    "@wordpress/dom-ready": "^3.50.0",
    "@wordpress/hooks": "^3.50.0",
    "@wpdev/hooks": "*",
    "@wpdev/html-utils": "*",
    "@wpdev/rest-utils": "*",
    "@wpdev/translation": "*",
    "@wpdev/utils": "*",
    "preact": "^10.19.3",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wordpress/e2e-test-utils-playwright": "^3.3.0",
    "@wordpress/env": "^12.2.0",
    "@wpdev/build": "*",
    "@wpdev/dependency-extraction-esbuild-plugin": "*",
    "jest": "^29.7.0",
    "npm-run-all": "*"
  }
}
