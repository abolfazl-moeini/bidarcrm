# BidarCRM NGINX server template (DocumentRoot = public/).

server {
    listen 80;
    server_name bidar.local;
    root /var/www/html/public;
    index index.html index.php;

    charset utf-8;
    client_max_body_size 50M;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Keep embedded lead-capture pages frameable. Child locations that set an
    # add_header must repeat the other headers because NGINX drops inheritance.
    location ~ ^/(app/)?lead-capture(/|$) {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors *;" always;
        try_files /app/index.html =404;
    }

    # Prefix match also covers /app/lead-capture/ (trailing slash), which would
    # otherwise fall into ^~ /app/ and re-apply SAMEORIGIN.
    location ^~ /app/lead-capture {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors *;" always;
        try_files /app/index.html =404;
    }

    # The ^~ app prefix prevents every PHP handler from running under /app/.
    location ^~ /app/ {
        try_files $uri $uri/ /app/index.html;
    }

    # EspoCRM client assets are served from the sibling client directory.
    location ^~ /client/ {
        alias /var/www/html/client/;
        try_files $uri =404;
    }

    # Never expose dotfiles other than the standardized .well-known directory.
    location ~ /\.(?!well-known) {
        return 404;
    }

    location ~* \.(log|sql|bak|swp|env|ini|sh|md|yml|yaml|lock)$ {
        return 404;
    }

    location ~* ^/(application|data|custom|vendor|logs|engine|packages|extensions|scripts|config|tests|docs|build|dist|docker|deploy|apps)/ {
        return 404;
    }

    location ~* ^/(composer|package(-lock)?|tsconfig)\.json$ {
        return 404;
    }

    location = /engine.version {
        return 404;
    }

    location = /install {
        return 301 /install/;
    }

    location /install/ {
        try_files $uri $uri/ /install/index.php?$args;
    }

    location /api/v1/portal-access/ {
        try_files $uri $uri/ /api/v1/portal-access/index.php?$args;
    }

    location /api/v1/ {
        try_files $uri $uri/ /api/v1/index.php?$args;
    }

    location /portal/ {
        try_files $uri $uri/ /portal/index.php?$args;
    }

    location /oauth/ {
        try_files $uri $uri/ /oauth/index.php?$args;
    }

    location = /oauth-callback.php {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        # For a separate Docker PHP-FPM service, use: fastcgi_pass php:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_hide_header X-Powered-By;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_ESPO_CGI_AUTH $http_espo_authorization;
        fastcgi_param HTTP_X_API_KEY $http_x_api_key;
        fastcgi_param HTTP_X_BIDAR_VOIP_SECRET $http_x_bidar_voip_secret;
        fastcgi_param HTTP_X_VOIP_TOKEN $http_x_voip_token;
        fastcgi_read_timeout 180s;
    }

    location ~ ^/(index\.php|api/v1/index\.php|api/v1/portal-access/index\.php|install/index\.php|portal/index\.php|portal/oauth-callback\.php|oauth/index\.php)$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        # For a separate Docker PHP-FPM service, use: fastcgi_pass php:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_hide_header X-Powered-By;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_ESPO_CGI_AUTH $http_espo_authorization;
        fastcgi_param HTTP_X_API_KEY $http_x_api_key;
        fastcgi_param HTTP_X_BIDAR_VOIP_SECRET $http_x_bidar_voip_secret;
        fastcgi_param HTTP_X_VOIP_TOKEN $http_x_voip_token;
        fastcgi_read_timeout 180s;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }

    # Deny every PHP script outside the explicit public entrypoint allowlist.
    location ~ \.php$ {
        return 404;
    }

    location ~ ^/admin(/|$) {
        rewrite ^/admin(/.*)?$ /index.php last;
    }

    # EspoCRM query-based entrypoints need the native front controller.
    location = / {
        if ($arg_entryPoint != "") {
            rewrite ^ /index.php last;
        }
        try_files /app/index.html =404;
    }

    location / {
        try_files $uri $uri/ /app/index.html;
    }
}
