# ==============================================================================
# BidarCRM - NGINX Server Configuration Template (Same-Origin Routing)
# Compatible with EspoCRM 10.1.4 & React Front-Office SPA
# ==============================================================================

server {
    listen 80;
    server_name bidar.local;
    root /var/www/html/public;
    index index.html index.php;

    charset utf-8;
    client_max_body_size 50M;

    # --------------------------------------------------------------------------
    # 1. Security: Block internal directories and sensitive files
    # --------------------------------------------------------------------------
    location ~* ^/(application|data|custom|vendor|logs|engine|packages|extensions)/ {
        deny all;
        return 404;
    }

    location ~* /\.(git|env|ui-level) {
        deny all;
        return 404;
    }

    location ~* \.(json|lock|version)$ {
        deny all;
        return 404;
    }

    # --------------------------------------------------------------------------
    # 2. EspoCRM Native API v1
    # --------------------------------------------------------------------------
    location /api/v1/ {
        try_files $uri $uri/ /api/v1/index.php?$args;
    }

    # --------------------------------------------------------------------------
    # 3. EspoCRM Native Assets & Admin
    # --------------------------------------------------------------------------
    location /client/ {
        try_files $uri =404;
    }

    location /install/ {
        try_files $uri $uri/ /install/index.php?$args;
    }

    location /admin {
        rewrite ^/admin/?(.*)$ /index.php last;
    }

    # Check for ?entryPoint= parameter
    if ($arg_entryPoint != "") {
        rewrite ^.*$ /index.php last;
    }

    # --------------------------------------------------------------------------
    # 4. Front-Office React SPA (/app/* and SPA routes fallback)
    # --------------------------------------------------------------------------
    location /app/ {
        try_files $uri $uri/ /app/index.html;
    }

    # Root and Front-Office SPA route fallback
    location / {
        try_files $uri $uri/ /app/index.html;
    }

    # --------------------------------------------------------------------------
    # 5. PHP FastCGI Processing
    # --------------------------------------------------------------------------
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        # Authentication header preservation for EspoCRM
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_ESPO_CGI_AUTH $http_espo_authorization;
        fastcgi_param HTTP_X_BIDAR_VOIP_SECRET $http_x_bidar_voip_secret;

        fastcgi_read_timeout 180s;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }
}
