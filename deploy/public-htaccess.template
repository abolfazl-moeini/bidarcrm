# BidarCRM public-directory rules (DocumentRoot = public/).
# When EspoCRM assets are outside this DocumentRoot, configure an Apache vhost
# Alias /client/ /absolute/path/to/client/ so the pass-through below can serve them.

Options -Indexes

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_headers.c>
    <If "%{REQUEST_URI} !~ m#^/(app/)?lead-capture(/|$)#">
        Header always set X-Frame-Options "SAMEORIGIN"
    </If>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Reject dotfiles except the standardized .well-known directory.
    RewriteRule (^|/)\.(?!well-known) - [F,L,NC]
    RewriteRule (^|/)(composer|package(-lock)?|tsconfig)\.json$ - [F,L,NC]
    RewriteRule (^|/)engine\.version$ - [F,L,NC]
    RewriteRule \.(log|sql|bak|swp|env|ini|sh|md|yml|yaml|lock)$ - [F,L,NC]

    # Preserve authentication and integration headers for PHP entrypoints.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule .* - [E=HTTP_ESPO_CGI_AUTH:%{HTTP:Espo-Authorization}]
    RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X-Api-Key}]
    RewriteRule .* - [E=HTTP_X_BIDAR_VOIP_SECRET:%{HTTP:X-Bidar-Voip-Secret}]
    RewriteRule .* - [E=HTTP_X_VOIP_TOKEN:%{HTTP:X-Voip-Token}]

    # EspoCRM API and entrypoints.
    RewriteRule ^api/v1/(.*)$ api/v1/index.php [QSA,L]
    RewriteCond %{QUERY_STRING} (^|&)entryPoint= [NC]
    RewriteRule ^.*$ index.php [QSA,L]
    RewriteRule ^install$ install/ [R=301,L]
    RewriteRule ^install/?(.*)$ install/$1 [QSA,L]
    RewriteRule ^oauth-callback\.php$ oauth-callback.php [L]
    RewriteRule ^admin(/.*)?$ index.php [QSA,L]

    # A vhost Alias handles /client/ when assets are outside this DocumentRoot.
    RewriteRule ^client/ - [L]

    # Front-office SPA routes, including / and /app without a trailing slash.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^app(/.*)?$ app/index.html [L]
    RewriteRule ^$ app/index.html [L]

    # Existing public files are served directly; all other routes reach the SPA.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^.*$ app/index.html [L]
</IfModule>
